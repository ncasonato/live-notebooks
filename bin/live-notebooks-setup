#!/usr/bin/env bash
# One-time setup for the live-notebooks plugin: writes ~/.jupyter_mcp/config and
# creates the private token. Safe to re-run; options not given keep their
# current value.
#
#   live-notebooks-setup --create [--with conda|uv|venv] [--env PREFIX] [--root DIR] [options]
#   live-notebooks-setup --env PREFIX [--root DIR] [options]
#   live-notebooks-setup --show
#   live-notebooks-setup --link [DIR]
#
#   --link [DIR]          write launchers for jkernel and live-notebooks-setup in DIR (default
#                         ~/.local/bin), so they work outside Claude Code too
#   --create              create the server env
#   --with MANAGER        conda, uv, or venv (python3 >= 3.10); default: the first found
#   --env PREFIX          the server env: runs JupyterLab + jupyter-mcp-server, not your
#                         analysis (that runs in kernels). Default with --create: ~/.jupyter_mcp/env
#   --root DIR            JupyterLab root; notebook paths are relative to it (default: $HOME)
#   --port N              default: 8000 + uid % 1000
#   --default-kernel SPEC kernel MCP gets when it starts one itself (see `jkernel specs`)
#   --max-notebook-mb N   largest notebook the MCP client can load (default: 256)
set -euo pipefail
# Plain bash 3.2 (macOS): no associative arrays, no GNU readlink.
PLUGIN="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$PLUGIN/scripts/common.sh"
require_unix

usage() { sed -n '2,20s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"; exit "${1:-0}"; }
abspath() { case $1 in /*) echo "$1" ;; *) echo "$PWD/$1" ;; esac; }
die() { echo "live-notebooks-setup: $*" >&2; exit 1; }

# Write launchers into $1 that run the commands from whichever plugin version
# Claude Code has installed: its bin/ is on PATH only inside Claude Code, and
# its path changes with every update.
LAUNCHER_MARK="# live-notebooks launcher"
link_commands() {
    local dir=$1 name target
    mkdir -p "$dir"
    for name in jkernel live-notebooks-setup; do
        target="$dir/$name"
        if [[ -e $target ]] && ! grep -q "^$LAUNCHER_MARK" "$target"; then
            die "$target exists and isn't a live-notebooks launcher; not replacing it"
        fi
        cat > "$target" <<EOF
#!/usr/bin/env bash
$LAUNCHER_MARK (written by live-notebooks-setup --link): runs $name
# from the live-notebooks plugin version that Claude Code has installed.
root=\$(python3 - <<'PY'
import json, os
path = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"),
                    "plugins", "installed_plugins.json")
try:
    for key, installs in json.load(open(path))["plugins"].items():
        if key.startswith("live-notebooks@") and installs:
            print(installs[0]["installPath"])
            break
except (OSError, ValueError, KeyError):
    pass
PY
)
if [[ -z \$root || ! -x \$root/bin/$name ]]; then
    echo "$name: the live-notebooks plugin isn't installed in Claude Code" >&2
    exit 1
fi
exec "\$root/bin/$name" "\$@"
EOF
        chmod +x "$target"
        echo "wrote launcher $target"
    done
    case ":$PATH:" in
        *":$dir:"*) ;;
        *) echo "note: $dir isn't on your PATH; add it in your shell's startup file" ;;
    esac
}

# Build the server env at $1 with manager $2 (conda, uv or venv), or with the
# first one found: conda/mamba (environment.yml), uv (fetches a Python if
# needed), a venv from python3 >= 3.10 (requirements.txt).
create_env() {
    local prefix=$1 manager=$2 conda py
    conda=$(conda_exe)
    py=$(python_310)
    if [[ -z $manager ]]; then
        local found=""
        [[ -n $conda ]] && found+=" conda"
        command -v uv > /dev/null && found+=" uv"
        [[ -n $py ]] && found+=" venv"
        [[ -n $found ]] || die "--create needs conda/mamba, uv, or Python >= 3.10" \
            "(e.g. brew install uv, or https://docs.astral.sh/uv/)"
        manager=${found# }; manager=${manager%% *}
        if [[ $found == " "*" "* ]]; then  # more than one
            echo "found:$found; using $manager (choose another with --with)"
        fi
    fi
    case $manager in
        conda)
            [[ -n $conda ]] || die "no conda/mamba found"
            echo "creating $prefix with $conda"
            "$conda" env create -y -p "$prefix" -f "$PLUGIN/environment.yml" ;;
        uv)
            command -v uv > /dev/null || die "no uv found"
            echo "creating $prefix with uv"
            uv venv --python 3.12 "$prefix"
            uv pip install --python "$prefix/bin/python" -r "$PLUGIN/requirements.txt" ;;
        venv)
            [[ -n $py ]] || die "no Python >= 3.10 found"
            echo "creating $prefix with $(command -v "$py") -m venv"
            "$py" -m venv "$prefix"
            "$prefix/bin/python" -m pip install -q --upgrade pip
            "$prefix/bin/python" -m pip install -r "$PLUGIN/requirements.txt" ;;
    esac
}

# Settings given on the command line, as KEY=VALUE lines.
new=""
create=false show=false manager=""
while (( $# )); do
    case $1 in
        --with)
            case $2 in conda|uv|venv) manager=$2 ;; *) die "--with takes conda, uv or venv" ;; esac
            shift ;;
        --env) new+="JUPYTER_MCP_ENV=$(abspath "$2")"$'\n'; shift ;;
        --root) new+="JUPYTER_ROOT=$(abspath "$2")"$'\n'; shift ;;
        --port) new+="JUPYTER_PORT=$2"$'\n'; shift ;;
        --default-kernel) new+="JUPYTER_DEFAULT_KERNEL=$2"$'\n'; shift ;;
        --max-notebook-mb)
            [[ $2 =~ ^[1-9][0-9]*$ ]] || { echo "--max-notebook-mb needs a whole number" >&2; exit 1; }
            new+="WEBSOCKETS_MAX_BODY_SIZE=$(( $2 * 1024 * 1024 ))"$'\n'; shift ;;
        --link)
            dir="$HOME/.local/bin"
            if [[ ${2:-} && $2 != --* ]]; then dir=$(abspath "$2"); fi
            link_commands "$dir"
            exit 0 ;;
        --create) create=true ;;
        --show) show=true ;;
        -h|--help) usage ;;
        *) echo "unknown option: $1" >&2; usage 1 ;;
    esac
    shift
done

mkdir -p "$JUPYTER_MCP_HOME"
chmod 700 "$JUPYTER_MCP_HOME"

if ! $show; then
    # Current config with the new values on top; for each key the last line wins.
    merged="$( { [[ -f $JUPYTER_MCP_CONFIG ]] && cat "$JUPYTER_MCP_CONFIG"; printf '%s' "$new"; } \
        | grep -E '^[A-Z_]+=' | awk -F= '{ v[$1] = $0 } END { for (k in v) print v[k] }' | sort || true)"

    env_prefix="$(printf '%s\n' "$merged" | sed -n 's/^JUPYTER_MCP_ENV=//p')"
    if [[ -z $env_prefix ]] && $create; then
        env_prefix="$JUPYTER_MCP_HOME/env"
        merged="$(printf '%s\nJUPYTER_MCP_ENV=%s' "$merged" "$env_prefix" | grep -E '^[A-Z_]+=' | sort)"
    fi
    if [[ -z $env_prefix ]]; then
        echo "live-notebooks-setup: give --create, or --env with an existing server env" >&2
        usage 1
    fi
    if $create; then
        create_env "$env_prefix" "$manager"
    elif [[ -n $manager ]]; then
        die "--with only applies with --create"
    fi
    if [[ ! -x $env_prefix/bin/jupyter-mcp-server || ! -x $env_prefix/bin/jupyter-lab ]]; then
        echo "live-notebooks-setup: $env_prefix lacks jupyterlab or jupyter-mcp-server (see the README)" >&2
        exit 1
    fi

    # Settings a running server was started with; changing them needs a restart.
    restart_keys='^(JUPYTER_MCP_ENV|JUPYTER_ROOT|JUPYTER_PORT|JUPYTER_DEFAULT_KERNEL)='
    old_port=$( (load_config; echo "$JUPYTER_PORT") )
    old=$( { [[ -f $JUPYTER_MCP_CONFIG ]] && grep -E "$restart_keys" "$JUPYTER_MCP_CONFIG"; } | sort || true)
    printf '%s\n' "$merged" > "$JUPYTER_MCP_CONFIG"
    if [[ $old != "$(printf '%s\n' "$merged" | grep -E "$restart_keys" | sort || true)" ]]; then
        running=$(our_server "$old_port"); running=${running%% *}
    fi

    if [[ ! -s $JUPYTER_MCP_TOKEN_FILE ]]; then
        # No trailing newline: Jupyter reads JUPYTER_TOKEN_FILE verbatim.
        (umask 077; "$env_prefix/bin/python" -c 'import secrets; print(secrets.token_hex(32), end="")' \
            > "$JUPYTER_MCP_TOKEN_FILE")
        echo "created token $JUPYTER_MCP_TOKEN_FILE"
    fi
fi

load_config
echo "config $JUPYTER_MCP_CONFIG:"
echo "  JUPYTER_MCP_ENV        ${JUPYTER_MCP_ENV:-(not set)}"
echo "  JUPYTER_ROOT           $JUPYTER_ROOT"
echo "  JUPYTER_PORT           $JUPYTER_PORT"
echo "  JUPYTER_DEFAULT_KERNEL $JUPYTER_DEFAULT_KERNEL"
echo "  WEBSOCKETS_MAX_BODY_SIZE $WEBSOCKETS_MAX_BODY_SIZE ($(( WEBSOCKETS_MAX_BODY_SIZE / 1024 / 1024 )) MB)"
if [[ -n ${running:-} ]]; then
    echo "Done. Your Jupyter server (PID $running) still runs with the old settings:" \
        "stop it with 'kill $running' (this also ends its kernels), then reconnect" \
        "with /mcp or restart Claude Code."
elif ! $show; then
    echo "Done. Reconnect the MCP server with /mcp (or restart Claude Code)."
fi
