#!/usr/bin/env bash
# Start the JupyterLab server used by jupyter-mcp-server.
#
# One server per user per machine, env-neutral: it runs from JUPYTER_MCP_ENV, and
# each project env is a kernel (see `jkernel specs`). Normally mcp-wrapper
# starts this automatically; run it by hand only to get a server without
# Claude Code. Settings: see common.sh.
#
# On a remote machine, reach it via: ssh -L <port>:localhost:<port> <host>
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/common.sh"
require_unix
load_config
require_setup
E=$JUPYTER_MCP_ENV
cd "$JUPYTER_ROOT" || exit 1
# jupyter-mcp-server always asks for a kernel named "python3", ignoring the
# server default. Shadow python3 with a copy of the default kernel's spec, on
# a JUPYTER_PATH private to this server so other Jupyter installs are untouched.
SHADOW="$JUPYTER_MCP_HOME/share/kernels/python3"
mkdir -p "$SHADOW"
"$E/bin/python" - "$JUPYTER_DEFAULT_KERNEL" "$SHADOW/kernel.json" <<'PY'
import json, sys
from jupyter_client.kernelspec import KernelSpecManager
name, out = sys.argv[1], sys.argv[2]
spec = KernelSpecManager().get_kernel_spec(name).to_dict()
spec["display_name"] += " [default]"
json.dump(spec, open(out, "w"), indent=1)
PY
export JUPYTER_PATH="$JUPYTER_MCP_HOME/share${JUPYTER_PATH:+:$JUPYTER_PATH}"
# Jupyter reads the token from the file itself, so it never appears on the
# command line (visible to every user on the machine via ps).
unset JUPYTER_TOKEN
export JUPYTER_TOKEN_FILE="$JUPYTER_MCP_TOKEN_FILE"
# WARN: at the default INFO level the log gains a line per request, without end.
exec "$E/bin/jupyter" lab --no-browser --ip 127.0.0.1 --port "$JUPYTER_PORT" \
    --port-retries 0 --log-level=WARN \
    --MappingKernelManager.default_kernel_name="$JUPYTER_DEFAULT_KERNEL" "$@"
