#!/usr/bin/env bash
# Launch jupyter-mcp-server with the Jupyter token taken from a private file,
# so it never appears in .mcp.json or on any process command line.
#
# If no Jupyter server of ours is running on this machine, start one first
# (start-jupyter, detached so it outlives this MCP process).
# stdout is the MCP stdio channel: every diagnostic must go to stderr.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/common.sh"
require_unix
load_config
require_setup
E=$JUPYTER_MCP_ENV
JUPYTER_TOKEN="$(< "$JUPYTER_MCP_TOKEN_FILE")"
export JUPYTER_TOKEN
# Overrides any JUPYTER_URL set elsewhere.
export JUPYTER_URL="http://127.0.0.1:$JUPYTER_PORT"
# Otherwise every MCP process starts (and then abandons) a kernel at launch.
export START_NEW_CODE_SANDBOX=false
# WEBSOCKETS_MAX_BODY_SIZE (exported by load_config) reaches the nbmodel client.
LOG="$JUPYTER_MCP_HOME/$(hostname -s).log"

# 0 = our server is up, 1 = nothing listening, 2 = port held by someone else.
server_status() {
    "$E/bin/python" - <<'PY'
import os, sys, urllib.request, urllib.error
req = urllib.request.Request(
    os.environ["JUPYTER_URL"] + "/api/status",
    headers={"Authorization": "token " + os.environ["JUPYTER_TOKEN"]},
)
try:
    urllib.request.urlopen(req, timeout=3)
except urllib.error.HTTPError:
    sys.exit(2)
except Exception:
    sys.exit(1)
PY
}

ours=$(our_server "$JUPYTER_PORT"); ours=${ours%% *}
status=0; server_status || status=$?
if (( status == 0 )) && [[ -n $ours ]] && ! our_server "$JUPYTER_PORT" | grep -qF " $E/"; then
    # Reusing it is still right (killing it would end the user's kernels),
    # but the config now names another env.
    echo "live-notebooks: your Jupyter server (PID $ours) runs from another env than" \
        "JUPYTER_MCP_ENV ($E); to switch, stop it (kill $ours) and reconnect with /mcp" >&2
elif (( status == 2 )); then
    # Our own JupyterLab answers 403 too once the token file has changed.
    if [[ -n $ours ]]; then
        echo "live-notebooks: your Jupyter server on port $JUPYTER_PORT (PID $ours) rejects" \
            "the token in $JUPYTER_MCP_TOKEN_FILE, which changed after it started;" \
            "stop it (kill $ours) and reconnect with /mcp" >&2
    else
        echo "live-notebooks: port $JUPYTER_PORT is in use by another server; set JUPYTER_PORT" >&2
    fi
    exit 1
elif (( status == 1 )); then
    mkdir -p "$JUPYTER_MCP_HOME"
    # Keep one previous log; JupyterLab's own logging is cut to warnings.
    if [[ -f $LOG ]] && (( $(wc -c < "$LOG") > 5 * 1024 * 1024 )); then
        mv -f "$LOG" "$LOG.old"
    fi
    echo "live-notebooks: starting Jupyter on $JUPYTER_URL (log: $LOG)" >&2
    # Detach by double fork into a new session, in Python since macOS has no
    # setsid command: the server is reparented to init, so it neither dies with
    # this MCP session nor lingers as its zombie child once stopped.
    "$E/bin/python" -c '
import os, sys
if os.fork() == 0:
    os.setsid()
    if os.fork() == 0:
        os.execv(sys.argv[1], sys.argv[1:])
    os._exit(0)
os.wait()
' "$HERE/start-jupyter" >> "$LOG" 2>&1 < /dev/null
    for _ in $(seq 1 60); do
        sleep 1
        status=0; server_status || status=$?
        (( status == 0 )) && break
    done
    if (( status != 0 )); then
        echo "live-notebooks: Jupyter did not come up; see $LOG" >&2
        exit 1
    fi
fi

exec "$E/bin/jupyter-mcp-server" "$@"
